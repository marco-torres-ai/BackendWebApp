@model BackendWebApp.Models.DetalleOperacion

@{
    ViewData["Title"] = "Detalles de la Operación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Detalle de Operación #@Model.IdDetalleOperacion</h4>
                    <span class="badge bg-light text-dark">ID: @Model.IdDetalleOperacion</span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Cliente:</dt>
                        <dd class="col-sm-8 fw-semibold">@(Model.CabeceraOperacion?.Cliente ?? "No asignado")</dd>

                        <dt class="col-sm-4 text-muted">Descripción:</dt>
                        <dd class="col-sm-8">@Model.Descripcion</dd>

                        <dt class="col-sm-4 text-muted">Cantidad:</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Cantidad</span></dd>

                        <dt class="col-sm-4 text-muted">Importe Base:</dt>
                        <dd class="col-sm-8">S/ @Model.Importe.ToString("N2")</dd>

                        <dt class="col-sm-4 text-muted">IGV (18%):</dt>
                        <dd class="col-sm-8 text-muted">S/ @Model.Igv.ToString("N2")</dd>

                        <hr class="my-2" />

                        <dt class="col-sm-4 text-dark fs-5">Total:</dt>
                        <dd class="col-sm-8 text-success fw-bold fs-5">S/ @Model.Total.ToString("N2")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Regresar al Listado
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.IdDetalleOperacion" class="btn btn-primary me-2">
                            Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.IdDetalleOperacion" class="btn btn-outline-danger">
                            Eliminar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
