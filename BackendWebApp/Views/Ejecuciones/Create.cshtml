@model BackendWebApp.Models.DetalleOperacion

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>DetalleOperacion</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="IdCabeceraOperacion" class="control-label">CLIENTE</label>
                <select asp-for="IdCabeceraOperacion" class="form-control"
                        asp-items="@(new SelectList(ViewBag.CabEjecuciones, "IdCabeceraOperacion", "Cliente"))">
                    <option value="">-- Seleccione un Cliente --</option>
                </select>
                <span asp-validation-for="IdCabeceraOperacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Importe" class="control-label"></label>
                <input asp-for="Importe" class="form-control" />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Igv" class="control-label"></label>
                <input asp-for="Igv" class="form-control" />
                <span asp-validation-for="Igv" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Total" class="control-label"></label>
                <input asp-for="Total" class="form-control" />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}