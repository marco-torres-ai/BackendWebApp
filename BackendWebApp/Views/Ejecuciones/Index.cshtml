@model IEnumerable<BackendWebApp.Models.DetalleOperacion>

@{
    ViewData["Title"] = "Lista de Ejecuciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0 text-primary">Lista de Ejecuciones</h2>
            <p class="text-muted small mb-0">Gestión de detalles de operaciones y transacciones</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + Nueva Operación
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 70px;">ID</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Importe</th>
                            <th class="text-end">IGV (18%)</th>
                            <th class="text-end">Total</th>
                            <th class="text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var ejecucion in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">@ejecucion.IdDetalleOperacion</td>
                                    <td>
                                        <span class="fw-semibold">@(ejecucion.CabeceraOperacion?.Cliente ?? "N/A")</span>
                                    </td>
                                    <td>@ejecucion.Descripcion</td>
                                    <td class="text-center"><span class="badge bg-secondary">@ejecucion.Cantidad</span></td>
                                    <td class="text-end">S/ @ejecucion.Importe.ToString("N2")</td>
                                    <td class="text-end text-muted">S/ @ejecucion.Igv.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">S/ @ejecucion.Total.ToString("N2")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@ejecucion.IdDetalleOperacion">
                                                Editar
                                            </a>
                                            <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@ejecucion.IdDetalleOperacion">
                                                Detalles
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@ejecucion.IdDetalleOperacion">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <em>No se encontraron registros de operaciones.</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
