@model BackendWebApp.Models.DetalleOperacion

@{
    ViewData["Title"] = "Editar Operación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Operación #@Model.IdDetalleOperacion</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="IdDetalleOperacion" />

                        <div class="mb-3">
                            <label asp-for="IdCabeceraOperacion" class="form-label fw-bold">Cliente</label>
                            <select asp-for="IdCabeceraOperacion" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.CabEjecuciones, "IdCabeceraOperacion", "Cliente", Model.IdCabeceraOperacion))">
                                <option value="">-- Seleccione un Cliente --</option>
                            </select>
                            <span asp-validation-for="IdCabeceraOperacion" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                            <input asp-for="Descripcion" class="form-control" placeholder="Ingrese la descripción" />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cantidad" class="form-label fw-bold">Cantidad</label>
                                <input asp-for="Cantidad" type="number" class="form-control" min="1" />
                                <span asp-validation-for="Cantidad" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Importe" class="form-label fw-bold">Importe (S/)</label>
                                <input asp-for="Importe" id="txtImporte" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="Importe" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row bg-light rounded p-2 mb-3">
                            <div class="col-md-6 mb-2">
                                <label asp-for="Igv" class="form-label small text-muted">IGV (18%)</label>
                                <input asp-for="Igv" id="txtIgv" type="number" step="0.01" class="form-control form-control-sm bg-white" readonly />
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="Total" class="form-label small text-muted">Total (S/)</label>
                                <input asp-for="Total" id="txtTotal" type="number" step="0.01" class="form-control form-control-sm bg-white fw-bold text-success" readonly />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Regresar al Listado
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const inputImporte = document.getElementById('txtImporte');
        const inputIgv = document.getElementById('txtIgv');
        const inputTotal = document.getElementById('txtTotal');

        function calcularTotales() {
            const importe = parseFloat(inputImporte.value) || 0;
            const igv = Math.round(importe * 0.18 * 100) / 100;
            const total = Math.round((importe + igv) * 100) / 100;
            inputIgv.value = igv.toFixed(2);
            inputTotal.value = total.toFixed(2);
        }

        inputImporte.addEventListener('input', calcularTotales);
    </script>
}
